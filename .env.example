# --- local development (npm run dev) ---------------------------------------------------------
DATABASE_URL="postgresql://daftar:daftar@localhost:5432/daftar_dev"

# --- docker compose (production) -------------------------------------------------------------
# Used by docker-compose.yml; copy this file to .env and fill them in. Never commit .env.
#
# Database password. Letters and digits only (it is placed inside a connection URL):
#   openssl rand -hex 24
# POSTGRES_PASSWORD=
# POSTGRES_USER=daftar
# POSTGRES_DB=daftar
#
# Public address of the site, baked into the build (page metadata). Rebuild after changing it.
# NEXT_PUBLIC_SITE_URL=https://daftar.example.com
#
# Host port the app is published on (127.0.0.1 only; point your reverse proxy at it)
# APP_PORT=3000
#
# First coach account (README, "Deploy"): `docker compose --profile tools run --rm create-coach --phone … --name …`
# reads COACH_PASSWORD from your shell (10+ characters) or generates one. Prefer exporting it just for that
# command over saving it here: this file is passed to the app container too.
# COACH_PASSWORD=
#
# The demo seed (`npm run db:seed`, public passwords) refuses to run with NODE_ENV=production unless this is 1.
# Leave it unset on a real server.
# SEED_DEMO=1
#
# Only if the npm registry or binaries.prisma.sh are unreachable from the build machine
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
# PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh
